{
    "name": "csgt/crud",
    "description": "CRUD implementation",
    "authors": [
        {
            "name": "Softlogic",
            "email": "software@softlogic.com.gt"
        }
    ],
    "require": {
        "php": ">=7.2"
    },
    "autoload": {
        "classmap": [],
        "psr-4": {
            "Csgt\\Crud\\": "src"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Csgt\\Crud\\CrudServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5",
        "illuminate/database": "^8.0 || ^9.0 || ^10.0",
        "illuminate/routing": "^8.0 || ^9.0 || ^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Csgt\\Crud\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
